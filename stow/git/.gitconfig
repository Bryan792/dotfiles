[include]
	path = ~/.config/git/identity.inc

[alias]
	co = checkout
	count = shortlog -sn
	wtf = !$DOTFILES/bin/git-wtf
	promote = !$DOTFILES/bin/git-promote
	rank-contributers = !$DOTFILES/bin/git-rank-contributers

[apply]
	whitespace = fix

[color]
	ui = auto

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold

[color "status"]
	added = yellow
	changed = green
	untracked = cyan

[core]
	excludesfile = ~/.gitignore
	attributesfile = ~/.gitattributes
	whitespace = space-before-tab,indent-with-non-tab,trailing-space

[credential]
	helper = cache

[pull]
	rebase = false

[init]
	defaultBranch = main
